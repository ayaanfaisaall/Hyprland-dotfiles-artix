{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "/home/ayaan/dotfiles/.config/fastfetch/logo/zaail.png", 
    "type": "kitty",
    "width": 22,
    "padding": {
      "top": 1,
      "left": 3,
      "right": 5,
      "bottom": 5    
    }
  },
  "display": {
    "color": {
      "keys": "1;38;5;255;48;2;25;80;155",
      "output": "38;5;255"
    },
    "separator": "     "
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "[  OS     ]"
    },
    {
      "type": "host",
      "key": "[ 󰒋 Host   ]"
    },
    {
      "type": "kernel",
      "key": "[  Kernel ]"
    },
    {
      "type": "shell",
      "key": "[  Shell  ]"
    },
    {
      "type": "wm",
      "key": "[  WM     ]"
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "38;2;25;80;155",
      "times": 12
    },
    {
      "type": "cpu",
      "key": "[  CPU    ]"
    },
    {
      "type": "memory",
      "key": "[ 󰘚 Memory ]"
    },
    {
      "type": "swap",
      "key": "[ 󰓡 Swap   ]"
    },
    {
      "type": "disk",
      "key": "[ 󰋊 Disk   ]"
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "38;2;25;80;155",
      "times": 12
    }
  ]
}
